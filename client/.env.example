# ──────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES TEMPLATE
# Rename this file to .env and fill in your actual credentials.
# Do NOT commit the actual .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── MongoDB Database ──
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>

# ── Authentication ──
# Generate a secure 256-bit secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_secure_random_string

# ── AI API Keys ──
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Optional: Google Gemini API key if using gemini.service.js
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server Config ──
PORT=5000
NODE_ENV=development
