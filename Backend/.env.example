PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
# ⚠️ IMPORTANT: In production, this MUST be a cryptographically secure 64-character random string.
# DO NOT use weak passwords like "starnote_secret". If this key is leaked or guessed, all user accounts are compromised.
# To generate a secure secret, run this in your terminal:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_generated_jwt_key_here

# AI Providers
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_AI_PROVIDER=gemini

# Email (Resend/SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=your_resend_api_key
SMTP_FROM=StarNote <onboarding@resend.dev>

# App Config
FRONTEND_URL=http://localhost:5173
USE_MOCK_DB=false
